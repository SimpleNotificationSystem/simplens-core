meta {
  name: Validate Admin Channel Config
  type: http
  seq: 2
}

post {
  url: {{process.env.BASE_URL}}/api/admin-channels/validate
  body: json
  auth: inherit
}

body:json {
  {
    "channel_type": "discord",
    "config": {
      "webhook_url": "{{process.env.DISCORD_WEBHOOK_URL}}"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
