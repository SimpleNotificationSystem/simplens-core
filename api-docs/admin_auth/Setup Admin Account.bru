meta {
  name: Signup Admin Account
  type: http
  seq: 2
}

post {
  url: {{process.env.BASE_URL}}/api/admin/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "username": "{{process.env.ADMIN_USERNAME}}",
    "password": "{{process.env.ADMIN_PASSWORD}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
