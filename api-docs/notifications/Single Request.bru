meta {
  name: Single Request
  type: http
  seq: 1
}

post {
  url: {{process.env.BASE_URL}}/api/notification
  body: json
  auth: inherit
}

body:json {
  {
    "request_id": "908604ba-2902-4e1e-be16-c05d1b371e21",
    "client_id": "59777441-3545-4507-8e0d-2d3a2ffd71c1",
    "template_id": ["email-temp-1"],
    "channel": ["{{process.env.CHANNEL}}", "mock"],
    "provider": ["{{process.env.PROVIDER}}"],
    "recipient": {
      "user_id": "user1234",
      "email": "{{TO_EMAIL}}"
    },
    "content":{
      "email": {
        "subject": "Test sample email",
        "message": "Hi, {{name}}. This email is from {{company}}"
      },
      "mock": {
        "message": "Hi, {{name}}. This message is from {{company}}"
      }
    }, 
    "variables": {
      "name": "Adhish",
      "company": "SimpleNS"
    },
    "webhook_url": "http://localhost:4000/webhook"
  }
}

vars:pre-request {
  TO_EMAIL: streamnowservice@gmail.com
}

settings {
  encodeUrl: true
  timeout: 0
}
