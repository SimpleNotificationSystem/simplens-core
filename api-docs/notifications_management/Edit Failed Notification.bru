meta {
  name: Edit Failed Notification
  type: http
  seq: 6
}

put {
  url: {{process.env.BASE_URL}}/api/notifications/{{process.env.NOTIFICATION_ID}}
  body: json
  auth: inherit
}

body:json {
  {
    "provider": "{{process.env.PROVIDER}}",
    "recipient": {
      "user_id": "user1234"
    },
    "content": {
      "message": "Hi Ada, your order 42 has shipped"
    },
    "variables": {
      "name": "Ada",
      "order_id": "42"
    },
    "webhook_url": "http://localhost:4000/webhook",
    "scheduled_at": "2026-11-19T09:00:00.000Z"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
