# ==============================================================================
# SimpleNS Essential Environment Configuration
# ==============================================================================
# NOTE: All operational settings (worker batch sizes, poll intervals, retries,
# deduplication TTLs, recovery thresholds, and log levels) are now managed
# dynamically via MongoDB and the Admin Dashboard with live zero-downtime hot-reloading!
#
# Administrator credentials are configured interactively on first launch via
# the Dashboard Setup UI (/setup) and stored securely in MongoDB.
# ==============================================================================

# ============================================
# API SERVER
# ============================================
NODE_ENV=production                # Set to 'production', 'development', or 'test'
PORT=3000                          # API server port
JWT_SECRET=                        # REQUIRED: Secret key for JWT admin tokens (min 32 chars, generate with: openssl rand -base64 32)

# ============================================
# DATABASE
# ============================================
# MongoDB connection URI (configured with replicaSet for change streams/transactions)
MONGO_URI=mongodb://mongo:27017/simplens?replicaSet=rs0
# ============================================
# KAFKA
# ============================================
BROKERS=kafka:9093             # Comma-separated Kafka broker addresses

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379  # Redis connection URL (used for pub/sub sync & locks)

# ============================================
# LOGGING (Grafana/Loki)
# ============================================
LOKI_URL=http://loki:3100     # Optional Loki endpoint for centralized logging
LOG_LEVEL=info                     # Initial bootstrap log level (debug, info, warn, error)
LOG_TO_FILE=true                   # Enable file transport logging to /logs directory

# ============================================
# ADMIN DASHBOARD
# ============================================
API_BASE_URL=http://api:3000/sns  # Core Notification service API URL
DASHBOARD_PORT=3002                     # Next.js Dashboard port
BASE_PATH=/sns                          # Optional subpath (e.g. /dashboard) or empty for root