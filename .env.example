# ==============================================================================
# SimpleNS Essential Environment Configuration
# ==============================================================================
# NOTE: All operational settings (worker batch sizes, poll intervals, retries,
# deduplication TTLs, recovery thresholds, and log levels) are now managed
# dynamically via MongoDB and the Admin Dashboard with live zero-downtime hot-reloading!
#
# Administrator credentials are configured interactively on first launch via
# the Dashboard Setup UI (/setup) and stored securely in MongoDB.
# ==============================================================================

# ============================================
# API SERVER
# ============================================
NODE_ENV=production                # Set to 'production', 'development', or 'test'
# Generate via: openssl rand -base64 32
NS_API_KEY=                        # API secret key for authenticating API requests
PORT=3000                          # API server port

# ============================================
# DATABASE
# ============================================
# MongoDB connection URI (configured with replicaSet for change streams/transactions)
MONGO_URI=mongodb://127.0.0.1:27017/notification_service?replicaSet=rs0

# ============================================
# KAFKA
# ============================================
BROKERS=localhost:9092             # Comma-separated Kafka broker addresses

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379   # Redis connection URL (used for pub/sub sync & locks)

# ============================================
# LOGGING (Grafana/Loki)
# ============================================
LOKI_URL=http://localhost:3100     # Optional Loki endpoint for centralized logging
LOG_LEVEL=info                     # Initial bootstrap log level (debug, info, warn, error)
LOG_TO_FILE=true                   # Enable file transport logging to /logs directory

# ============================================
# ADMIN DASHBOARD
# ============================================
AUTH_TRUST_HOST=true               # Trust host header for authentication cookies
AUTH_SECRET=                       # Dashboard session signing secret (defaults to NS_API_KEY if omitted)
API_BASE_URL=http://localhost:3000 # Core Notification service API URL
WEBHOOK_HOST=dashboard             # Webhook callback host
WEBHOOK_PORT=3002                  # Dashboard webhook port
DASHBOARD_PORT=3002                # Next.js Dashboard port
BASE_PATH=/dashboard               # Optional subpath (e.g. /dashboard) or empty for root
HTTPS_COOKIE=false                 # Controls cookie Secure flag ('true' for HTTPS prod, 'false' for local HTTP)