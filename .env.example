# ==============================================================================
# SimpleNS Essential Environment Configuration
# ==============================================================================
# NOTE: All operational settings (worker batch sizes, poll intervals, retries,
# deduplication TTLs, recovery thresholds, and log levels) are now managed
# dynamically via MongoDB and the Admin Dashboard with live zero-downtime hot-reloading!
#
# Administrator credentials are configured interactively on first launch via
# the Dashboard Setup UI (/setup) and stored securely in MongoDB.
# ==============================================================================

# ============================================
# API SERVER
# ============================================
# Set to 'production', 'development', or 'test'
NODE_ENV=production
# API server port
PORT=3000
# REQUIRED: Secret key for JWT admin tokens (min 32 chars, generate with: openssl rand -base64 32)
JWT_SECRET=

# ============================================
# DATABASE
# ============================================
# MongoDB connection URI (configured with replicaSet for change streams/transactions)
MONGO_URI=mongodb://mongo:27017/simplens?replicaSet=rs0

# ============================================
# KAFKA
# ============================================
# Comma-separated Kafka broker addresses
BROKERS=kafka:9093

# ============================================
# REDIS
# ============================================
# Redis connection URL (used for pub/sub sync & locks)
REDIS_URL=redis://redis:6379

# ============================================
# LOGGING (Grafana/Loki)
# ============================================
# Optional Loki endpoint for centralized logging
LOKI_URL=http://loki:3100
# Initial bootstrap log level (debug, info, warn, error)
LOG_LEVEL=info
# Enable file transport logging to /logs directory
LOG_TO_FILE=true

# ============================================
# ADMIN DASHBOARD
# ============================================
# Internal URL used by Dashboard to talk to the API inside the container
API_BASE_URL=http://localhost:3000
# Next.js Dashboard port
DASHBOARD_PORT=3002
# Optional subpath (e.g. /dashboard) or empty for root
BASE_PATH=
