{
  "name": "@simplens/mcp",
  "version": "1.1.0",
  "description": "Remote MCP server for SimpleNS notification orchestration engine",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "simplens-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "stdio": "node dist/index.js --stdio",
    "dev": "tsx watch src/index.ts",
    "test": "npm run build && tsx tests/verify-stdio.ts"
  },
  "keywords": [
    "mcp",
    "simplens",
    "notifications",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "zod": "^4.1.13",
    "dotenv": "^17.2.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
