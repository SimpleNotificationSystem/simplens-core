{
  "name": "@simplens/create-simplens-plugin",
  "version": "1.0.0",
  "description": "CLI tool to scaffold new SimpleNS notification plugins",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "create-simplens-plugin": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run build:copy",
    "build:copy": "xcopy /E /I /Y src\\templates dist\\templates",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "simplens",
    "plugin",
    "cli",
    "scaffolding",
    "generator",
    "notification"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "change-case": "^5.4.4",
    "commander": "^12.1.0",
    "handlebars": "^4.7.8",
    "inquirer": "^12.2.0",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SimpleNotificationSystem/create-simplens-plugin"
  }
}
