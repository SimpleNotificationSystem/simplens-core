#!/bin/sh
echo "🔍 Running lint checks before push..."

npm run lint:core
if [ $? -ne 0 ]; then
  echo "❌ Core lint check failed. Push aborted."
  exit 1
fi

npm run lint:dashboard
if [ $? -ne 0 ]; then
  echo "❌ Dashboard lint check failed. Push aborted."
  exit 1
fi

echo "✅ All lint checks passed! Proceeding with push..."
