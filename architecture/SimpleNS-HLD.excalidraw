      "boundElements": [],
      "updated": 1788620516835,
      "link": null,
      "locked": false,
      "text": "if notification_id not\nfound in Redis, checks\nfor rate limits before \nprocessing event and\nwrites it to Redis if\nunder rate limit, \nelse pushes to\ndelayed_topic. It\ndiscards the event if\nalready processed.\n(Idempotentcy)",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "yx-Jenq1CWwYWxa7KfqpP",
      "originalText": "if notification_id not found in Redis, checks for rate limits before \nprocessing event and writes it to Redis if under rate limit, \nelse pushes to delayed_topic. It discards the event if already processed.\n(Idempotentcy)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
